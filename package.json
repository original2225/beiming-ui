{
  "name": "beiming-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "北冥 UI — 通用中式组件库 + 官网 / 网盘两套特化主题（共存，互不依赖）",
  "workspaces": [
    "packages/*",
    "studio"
  ],
  "scripts": {
    "dev": "npm run dev -w studio",
    "build": "npm run build --workspaces --if-present",
    "build:registry": "node scripts/build-registry.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "lucide-react": "^1.23.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}